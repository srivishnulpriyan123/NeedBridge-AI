# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Note: Use 5432 for default global postgres or 5433 for project local cluster
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=needbridge_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret Configuration
JWT_SECRET=needbridge_jwt_super_secret_development_key_2026!
JWT_EXPIRES_IN=7d

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# PayPal Developer Sandbox Configuration
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD

# CORS Allowed Origins (Comma-separated for Vite frontend ports)
CLIENT_URL=http://localhost:3000,http://localhost:3001

